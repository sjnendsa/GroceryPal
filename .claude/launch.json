{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "grocery-pal",
      "runtimeExecutable": "python",
      "runtimeArgs": ["app.py"],
      "port": 5000,
      "autoPort": true
    },
    {
      "name": "static-docs",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd /tmp/gp_docs && exec python3 -m http.server 8770"],
      "port": 8770
    }
  ]
}
